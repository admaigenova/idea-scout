# Anthropic API key (console.anthropic.com) — scores the posts
ANTHROPIC_API_KEY=

# Resend API key (resend.com) — sends the email
RESEND_API_KEY=

# Where the daily digest goes. With the default onboarding@resend.dev sender,
# Resend only delivers to the address you signed up to Resend with — verify a
# domain in Resend to send anywhere else.
EMAIL_TO=you@example.com

# ---- Optional: only needed when the Reddit API (PRAW) source is enabled ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:idea-scout:1.0 (by /u/your_username)
